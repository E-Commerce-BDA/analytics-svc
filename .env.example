NODE_ENV=development
PORT=4060
# Local Mongo runs as a single-node replica set (rs0) on host port 27018.
MONGODB_URI=mongodb://localhost:27018/ecom_analytics?replicaSet=rs0&directConnection=true
KAFKA_BROKERS=localhost:9092
# Ingest rate limit: 60 beacons per session per 60s window.
TRACK_RATE_LIMIT_MAX=60
TRACK_RATE_LIMIT_WINDOW_MS=60000
